<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет: Android требует XML-разметку. Всё содержимое рисуется кодом (EqWidget) в w_image,
     здесь только полоса волны и кнопки плеера поверх картинки. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_name"
        android:scaleType="fitXY" />

    <!-- волна-всплески: отдельная полоса, чтобы обновлять только её несколько раз в секунду;
         место задаёт EqWidget отступами (setViewPadding) -->
    <FrameLayout
        android:id="@+id/w_wave_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/w_wave"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_prev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/prev_track"
            android:padding="10dp"
            android:src="@drawable/ic_skip_previous" />

        <ImageView
            android:id="@+id/w_play"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="@string/play_pause"
            android:padding="11dp"
            android:src="@drawable/ic_play" />

        <ImageView
            android:id="@+id/w_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/next_track"
            android:padding="10dp"
            android:src="@drawable/ic_skip_next" />
    </LinearLayout>
</FrameLayout>
